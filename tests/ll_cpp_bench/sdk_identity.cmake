# The same manifest format as scripts/record_shmem_sdk.py, for a clean pinned SDK.
cmake_minimum_required(VERSION 3.20)
file(READ "${PROJECT_ROOT}/dependencies.lock.json" _lock)
string(JSON _revision GET "${_lock}" shmem revision)
if(MODE STREQUAL "source")
    execute_process(COMMAND git -C "${SHMEM_SOURCE}" rev-parse HEAD
        OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND git -C "${SHMEM_SOURCE}" status --porcelain --untracked-files=normal
        OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT _head STREQUAL _revision OR NOT _dirty STREQUAL "")
        message(FATAL_ERROR "Use the clean pinned SHMEM submodule for this SDK build")
    endif()
    return()
endif()
if(NOT MODE MATCHES "^(record|check)$")
    message(FATAL_ERROR "Expected source, record or check mode")
endif()
string(JSON _count LENGTH "${_lock}" shmem header_sha256_lf)
math(EXPR _last "${_count}-1")
foreach(_i RANGE 0 ${_last})
    string(JSON _name MEMBER "${_lock}" shmem header_sha256_lf ${_i})
    string(JSON _expected GET "${_lock}" shmem header_sha256_lf "${_name}")
    file(READ "${SDK}/include/${_name}" _contents)
    string(REPLACE "\r\n" "\n" _contents "${_contents}")
    string(SHA256 _actual "${_contents}")
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "SDK header differs from the dependency lock: ${_name}")
    endif()
endforeach()
if(MODE STREQUAL "check")
    file(READ "${SDK}/deepep-sdk.json" _identity)
    string(JSON _recorded GET "${_identity}" revision)
    if(NOT _recorded STREQUAL _revision)
        message(FATAL_ERROR "SDK revision differs from the dependency lock")
    endif()
    string(JSON _count LENGTH "${_identity}" sha256)
    math(EXPR _last "${_count}-1")
    foreach(_i RANGE 0 ${_last})
        string(JSON _name MEMBER "${_identity}" sha256 ${_i})
        string(JSON _expected GET "${_identity}" sha256 "${_name}")
        file(SHA256 "${SDK}/${_name}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "SDK file changed: ${_name}")
        endif()
    endforeach()
    return()
endif()
if(EXISTS "${SDK}/deepep-sdk.json")
    message(FATAL_ERROR "SDK identity already exists; use check mode")
endif()
file(GLOB_RECURSE _flags "${SDK_BUILD}/flags.make")
list(FILTER _flags INCLUDE REGEX "/CMakeFiles/aclshmem_device[.]dir/flags[.]make$")
set(_modes "")
foreach(_file IN LISTS _flags)
    file(READ "${_file}" _text)
    string(REGEX MATCHALL "-DACLSHMEMI_HNS_1825_PI_ON_CHIP=[01]([ \n\r]|$)" _definitions "${_text}")
    if(NOT _definitions)
        message(FATAL_ERROR "HNS_1825 doorbell mode missing from ${_file}")
    endif()
    foreach(_definition IN LISTS _definitions)
        string(REGEX MATCH "=[01]" _mode "${_definition}")
        string(SUBSTRING "${_mode}" 1 1 _mode)
        list(APPEND _modes "${_mode}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES _modes)
list(LENGTH _modes _mode_count)
if(NOT _mode_count EQUAL 1)
    message(FATAL_ERROR "Missing or inconsistent HNS_1825 device compile flags")
endif()
file(STRINGS "${ASCEND_HOME_PATH}/compiler/version.info" _version REGEX "^Version=")
string(REPLACE "Version=" "" _version "${_version}")
if(NOT _version MATCHES "^9\\.[23]\\.0$")
    message(FATAL_ERROR "Use the branch's CANN 9.2.0 or 9.3.0 SDK")
endif()
file(STRINGS "${ASCEND_HOME_PATH}/compiler/version.info" _stamp REGEX "^timestamp=")
string(REPLACE "timestamp=" "" _stamp "${_stamp}")
if(_stamp STREQUAL "")
    set(_stamp unknown)
endif()
set(_identity "{\"revision\":\"${_revision}\",\"sha256\":{},\"build\":{\"cann_version\":\"${_version}\",\"cann_timestamp\":\"${_stamp}\",\"target\":\"Ascend950\",\"source_patches\":[],\"rdma_backend\":\"HNS_1825\",\"hns_1825_pi_on_chip\":${_modes}}}")
file(GLOB_RECURSE _headers "${SDK}/include/*.h")
set(_files ${_headers} "${SDK}/lib/libshmem.so" "${SDK}/lib/aclshmem_bootstrap_mpi.so")
foreach(_file IN LISTS _files)
    file(RELATIVE_PATH _name "${SDK}" "${_file}")
    file(SHA256 "${_file}" _hash)
    string(JSON _identity SET "${_identity}" sha256 "${_name}" "\"${_hash}\"")
endforeach()
file(WRITE "${SDK}/deepep-sdk.json" "${_identity}\n")
